# Cloudflare Pages header rules.
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  # Pyodide's loader compiles WebAssembly and evaluates generated JavaScript, so
  # both eval forms are required for the page to run at all. The Python it runs
  # is the visitor's own file passing through MarkItDown, inside the WebAssembly
  # sandbox, and no network origin other than the ones listed here is reachable.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://cdn.jsdelivr.net; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# Wheel filenames carry their version, so a given URL never changes content.
/vendor/wheels/*
  Cache-Control: public, max-age=31536000, immutable

# The manifest names those wheels; it must not outlive a deploy.
/vendor/manifest.json
  Cache-Control: public, max-age=60, must-revalidate

/samples/*
  Cache-Control: public, max-age=86400

/assets/*
  Cache-Control: public, max-age=3600, must-revalidate
